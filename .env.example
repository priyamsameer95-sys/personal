# Optional: force an empty, read-only public preview during local development.
# With no database configured, development uses this mode automatically.
# Ignored in production. Admin changes always require a real database.
LOCAL_PREVIEW=false

# Optional public site origin for absolute social-preview image URLs.
# Include https://. Vercel deployments use their provided hostname automatically.
NEXT_PUBLIC_SITE_URL=

# Active Next.js app: use the pooled connection URL provided by Vercel/Neon.
# DATABASE_URL is used only by the separate backend/ project, not this client.
POSTGRES_URL=

# Admin sign-in and session signing. Set a strong, unique password locally
# (at least 20 characters) before using /minforyam; configure it separately in hosting.
ADMIN_PASSWORD=

# Optional separate signing secret for cookie-free, daily anonymous visitor estimates.
# Defaults to the existing server-only admin secret. Never use a NEXT_PUBLIC_ key.
ANALYTICS_SECRET=

# Vercel Blob uploads and deletions through the Next.js admin panel.
BLOB_READ_WRITE_TOKEN=

# Optional explicit public Blob store host. Must match the token's store ID.
# No arbitrary external media URLs are accepted by the publishing API.
CMS_BLOB_HOSTNAME=

# Web database migrations are disabled by default. Enable only for maintenance,
# then remove the flag. Ordinary publishing never requires this permission.
ADMIN_MIGRATIONS_ENABLED=false

# Optional separate server-only secret for hashed persistent login budgets.
# Defaults to POSTGRES_URL; never expose this value through NEXT_PUBLIC_.
ADMIN_LOGIN_RATE_SECRET=
